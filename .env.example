# Distributed Agent Harness — local environment template.
#
# Copy this file to `.env` (which is git-ignored) and fill in your values:
#
#     cp .env.example .env
#
# Then pass the file to uv when running anything that needs an LLM:
#
#     uv run --env-file .env python -m examples.interfaces.web_console
#
# `uv run --env-file` loads these into the subprocess environment for the
# duration of the command. No new Python dependencies needed.

# Required for any example that calls a real LLM (the web console, the
# `python -m distributed_agent_harness.chat` REPL, etc.). Get a free key at
# https://console.mistral.ai → API keys.
MISTRAL_API_KEY=
